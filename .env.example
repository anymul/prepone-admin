# Copy to .env (local dev) — .env is git-ignored.
# Same-origin path: in dev, Vite proxies /api -> VITE_DEV_API_TARGET (default http://127.0.0.1:3000).
VITE_API_URL=/api/v1

# Optional: where the dev server proxies /api. Only used by `pnpm run dev`.
# VITE_DEV_API_TARGET=http://127.0.0.1:3000

# Optional: minutes of inactivity before auto sign-out (default 60, 0 disables).
# VITE_IDLE_TIMEOUT_MIN=60
